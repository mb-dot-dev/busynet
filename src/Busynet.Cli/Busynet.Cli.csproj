<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>busynet</AssemblyName>
    <RootNamespace>Busynet.Cli</RootNamespace>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>busynet</ToolCommandName>
    <PackageId>busynet</PackageId>
    <Version>0.1.0</Version>
    <Description>Console application to display various information on a BUSY Bar.</Description>
    <Authors>mb-dot-dev</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mb-dot-dev/busynet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Busynet.Core/Busynet.Core.csproj" />
    <ProjectReference Include="../Busynet.Bar/Busynet.Bar.csproj" />
    <ProjectReference Include="../Busynet.Claude/Busynet.Claude.csproj" />
  </ItemGroup>
</Project>
